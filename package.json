{
  "name": "chime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "preview": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run version:check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write . && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path crates/chime-engine/Cargo.toml",
    "format:check": "oxfmt --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo fmt --manifest-path crates/chime-engine/Cargo.toml --check",
    "test": "bun test && bun run test:rust",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo test --locked --manifest-path crates/chime-engine/Cargo.toml --target-dir src-tauri/target",
    "bundle": "tauri build",
    "version:check": "bun scripts/check-version.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.4"
}
