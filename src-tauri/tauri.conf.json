{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chime",
  "version": "0.1.0",
  "identifier": "xyz.rensberger.chime",
  "build": {
    "beforeDevCommand": "bun run preview",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chime",
        "width": 820,
        "height": 850,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local voice dictation",
    "longDescription": "Transcribe speech locally with microphone capture, clipboard output, and searchable transcript history.",
    "linux": {
      "deb": {
        "depends": ["libasound2", "libpulse0", "wl-clipboard", "wtype", "libgtk-layer-shell0"]
      }
    }
  }
}
